# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Database PostgreSQL (database modena, schema usrmgnt)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=modena
DB_USER=postgres
DB_PASSWORD=change-me
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/modena?schema=usrmgnt
# Database khusus test integrasi (dibuat ulang otomatis setiap npm test)
TEST_DB_NAME=modena_test

# Redis (cache permission)
REDIS_URL=redis://localhost:6379
PERMISSION_CACHE_TTL=600

# JWT
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d
